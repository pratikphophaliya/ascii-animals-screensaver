{
  "name": "ascii-animals-screensaver",
  "productName": "ASCII Animals",
  "version": "1.0.1",
  "description": "Pixel and ASCII animals wander across your desktop when you step away. A tiny screensaver for Windows.",
  "author": "pratikphophaliya",
  "homepage": "https://github.com/pratikphophaliya/ascii-animals-screensaver",
  "repository": {
    "type": "git",
    "url": "https://github.com/pratikphophaliya/ascii-animals-screensaver.git"
  },
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "preview": "electron . /s",
    "dist": "electron-builder --win nsis",
    "dist:store": "node scripts/build-store.js"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.asciianimals.screensaver",
    "productName": "ASCII Animals",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "ASCII-Animals-Setup-${version}.${ext}"
    },
    "appx": {
      "displayName": "ASCII Animals",
      "applicationId": "AsciiAnimals",
      "backgroundColor": "#0d1016",
      "addAutoLaunchExtension": true,
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    },
    "publish": {
      "provider": "github",
      "owner": "pratikphophaliya",
      "repo": "ascii-animals-screensaver",
      "releaseType": "release"
    }
  }
}
